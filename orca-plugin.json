{
  "manifestVersion": 2,
  "id": "decision-inbox",
  "name": "Decision Inbox",
  "version": "0.2.1",
  "description": "Read authorized Bot Items and save answers to workspace Chat decisions.",
  "engines": { "orca": ">=1.4.248" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      { "id": "inbox", "title": "Decision Inbox", "icon": "flag", "entry": "src/panel.tsx", "ui": "components" }
    ],
    "customEditors": [
      { "id": "review", "title": "Decision Review", "extensions": [".orca-decision"], "entry": "src/review.ts", "frame": "isolated" }
    ],
    "newFiles": [
      { "id": "dashboard", "title": "Decision Inbox dashboard", "extension": ".orca-decision", "template": "templates/dashboard.orca-decision" }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" }
  ]
}
